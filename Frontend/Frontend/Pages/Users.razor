@page "/users"
@using Frontend.Models
@using Frontend.State
@inject HttpClient Http
@inject UsersService UsersService
@inject ServerSelectionState ServerSelectionState
@implements IDisposable

<h3>Discord Users</h3>
@if (users is null)
{
    <p>Loading users...</p>
}
else if (string.IsNullOrEmpty(ServerSelectionState.SelectedServerId))
{
    <p>No server selected.</p>
}
else if (users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <ul>
        @foreach (var user in users)
        {
            <li>@user.Username</li>
        }
    </ul>
}
@code {
    private List<DiscordUser>? users;

    protected override async Task OnInitializedAsync()
    {
        ServerSelectionState.OnChange += OnServerChanged;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        var serverId = ServerSelectionState.SelectedServerId;

        if (string.IsNullOrEmpty(serverId))
        {
            users = new List<DiscordUser>();
            return;
        }

        users = null;
        StateHasChanged();
        users = await UsersService.GetUsersAsync(serverId);
    }
    private void OnServerChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadUsersAsync();
            StateHasChanged();
        });
    }
    public void Dispose()
    {
        ServerSelectionState.OnChange -= OnServerChanged;
    }
}
